<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:id="@+id/dashboardScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/dashboardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dashboard_padding">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/app_name"
                android:textSize="30sp" android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary" android:tag="heading" />
            <TextView android:id="@+id/tvEngineStatusBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="12dp" android:background="@drawable/bg_pill_inactive"
                android:text="@string/status_ready" android:textSize="13sp"
                android:textColor="@color/primary" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <TextView style="@style/BodyText" android:text="@string/brand_caption"
            android:letterSpacing="0.12" android:textSize="11sp" />

        <LinearLayout style="@style/Card" android:background="@drawable/bg_hero_glow">
            <TextView style="@style/SectionTitle" android:text="@string/hero_title"
                android:textSize="32sp" android:fontFamily="sans-serif-medium" />
            <TextView style="@style/BodyText" android:text="@string/hero_description" />
            <com.wellness.overlay3d.overlay.DevCompanionCanvasView
                android:id="@+id/liveDashboardCompanion"
                android:layout_width="match_parent" android:layout_height="180dp"
                android:layout_marginTop="8dp" android:contentDescription="@string/tap_companion" />
            <TextView android:id="@+id/tvLiveCompanionSpeech" style="@style/BodyText"
                android:text="@string/demo_message" android:gravity="center"
                android:textColor="@color/text_primary" android:accessibilityLiveRegion="polite" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:scrollbars="none"
                android:requiresFadingEdge="horizontal" android:fadingEdgeLength="@dimen/chip_row_fade">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <Button android:id="@+id/btnPoseHappy" style="@style/Choice" android:text="@string/pose_cheer" />
                    <Button android:id="@+id/btnPoseWater" style="@style/Choice" android:text="@string/pose_water" />
                    <Button android:id="@+id/btnPoseEyes" style="@style/Choice" android:text="@string/pose_eyes" />
                    <Button android:id="@+id/btnPoseTask" style="@style/Choice" android:text="@string/pose_focus" />
                    <Button android:id="@+id/btnPoseThread" style="@style/Choice" android:text="@string/pose_drop" />
                </LinearLayout>
            </HorizontalScrollView>
            <Button android:id="@+id/btnTestCompanionNow" style="@style/PrimaryButton"
                android:text="@string/preview_companion" />
        </LinearLayout>

        <LinearLayout android:id="@+id/llMandatoryOverlayBanner" style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="@string/permission_title" />
            <TextView style="@style/BodyText" android:text="@string/permission_description" />
            <TextView style="@style/BodyText" android:text="@string/overlay_settings_hint" />
            <Button android:id="@+id/btnMandatoryGrant" style="@style/PrimaryButton"
                android:text="@string/grant_overlay" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchEnableCompanion"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:paddingStart="4dp" android:paddingEnd="4dp"
                android:text="@string/enable_companion" android:textSize="18sp"
                android:textColor="@color/text_primary" />
            <TextView android:id="@+id/tvHeroSubtitle" style="@style/BodyText"
                android:text="@string/paused_description" />
            <TextView android:id="@+id/tvRuntimeError" style="@style/BodyText"
                android:textColor="@color/error" android:accessibilityLiveRegion="polite"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="@string/rhythm_title" />
            <TextView style="@style/BodyText" android:text="@string/rhythm_description" />
            <TextView style="@style/BodyText" android:text="@string/water_title"
                android:layout_marginTop="20dp" />
            <TextView android:id="@+id/tvWaterCountdown" style="@style/SectionTitle"
                android:tag="metric" android:text="@string/countdown_paused"
                android:textSize="28sp" android:fontFamily="sans-serif-medium" />
            <ProgressBar android:id="@+id/waterProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:layout_marginTop="8dp" android:max="1000"
                android:importantForAccessibility="no" android:progressTint="@color/primary" />
            <TextView style="@style/BodyText" android:text="@string/eye_title"
                android:layout_marginTop="20dp" />
            <TextView android:id="@+id/tvEyeCountdown" style="@style/SectionTitle"
                android:tag="metric" android:text="@string/countdown_paused"
                android:textSize="28sp" android:fontFamily="sans-serif-medium" />
            <ProgressBar android:id="@+id/eyeProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:layout_marginTop="8dp" android:max="1000"
                android:importantForAccessibility="no" android:progressTint="@color/primary" />
            <TextView style="@style/BodyText" android:text="@string/eye_interval"
                android:layout_marginTop="20dp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none"
                android:requiresFadingEdge="horizontal" android:fadingEdgeLength="@dimen/chip_row_fade">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <Button android:id="@+id/chipEye15" style="@style/Choice" android:text="@string/minutes_15" />
                    <Button android:id="@+id/chipEye20" style="@style/Choice" android:text="@string/minutes_20" />
                    <Button android:id="@+id/chipEye30" style="@style/Choice" android:text="@string/minutes_30" />
                    <Button android:id="@+id/chipEye45" style="@style/Choice" android:text="@string/minutes_45" />
                </LinearLayout>
            </HorizontalScrollView>
            <TextView style="@style/BodyText" android:text="@string/water_interval"
                android:layout_marginTop="16dp" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none"
                android:requiresFadingEdge="horizontal" android:fadingEdgeLength="@dimen/chip_row_fade">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <Button android:id="@+id/chipWater15" style="@style/Choice" android:text="@string/minutes_15" />
                    <Button android:id="@+id/chipWater30" style="@style/Choice" android:text="@string/minutes_30" />
                    <Button android:id="@+id/chipWater45" style="@style/Choice" android:text="@string/minutes_45" />
                    <Button android:id="@+id/chipWater60" style="@style/Choice" android:text="@string/minutes_60" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="@string/tasks_title" />
            <TextView android:id="@+id/tvTaskCount" style="@style/BodyText" android:text="@string/tasks_description" />
            <Button android:id="@+id/btnAddNewTask" style="@style/PrimaryButton" android:text="@string/add_task" />
            <TextView android:id="@+id/tvTaskError" style="@style/BodyText"
                android:textColor="@color/error" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <LinearLayout android:id="@+id/llTasksContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:orientation="vertical" />
            <TextView android:id="@+id/tvEmptyTasks" style="@style/BodyText"
                android:text="@string/empty_tasks" android:paddingTop="12dp" android:paddingBottom="12dp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="@string/appearance_title" />
            <TextView style="@style/BodyText" android:text="@string/entrance_label" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none"
                android:requiresFadingEdge="horizontal" android:fadingEdgeLength="@dimen/chip_row_fade">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <Button android:id="@+id/chipPosAuto" style="@style/Choice" android:text="@string/entrance_auto" />
                    <Button android:id="@+id/chipPosThread" style="@style/Choice" android:text="@string/entrance_drop" />
                    <Button android:id="@+id/chipPosTopRight" style="@style/Choice" android:text="@string/entrance_corner" />
                    <Button android:id="@+id/chipPosBottom" style="@style/Choice" android:text="@string/entrance_bottom" />
                </LinearLayout>
            </HorizontalScrollView>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchVoice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:minHeight="48dp"
                android:text="@string/voice_label" android:textSize="16sp" />
            <TextView style="@style/BodyText" android:text="@string/voice_description" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchReducedMotion"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:minHeight="48dp"
                android:text="@string/motion_label" android:textSize="16sp" />
            <TextView style="@style/BodyText" android:text="@string/motion_description" />
        </LinearLayout>
        <LinearLayout android:id="@+id/notificationBanner" style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="@string/notifications_title" />
            <TextView style="@style/BodyText" android:text="@string/notifications_description" />
            <Button android:id="@+id/btnNotifications" style="@style/PrimaryButton"
                android:text="@string/allow_notifications" />
        </LinearLayout>
        <TextView style="@style/BodyText" android:text="@string/privacy_footer"
            android:layout_marginTop="24dp" android:gravity="center" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
</FrameLayout>
