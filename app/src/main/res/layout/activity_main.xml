<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="myfrnd"
                    android:textColor="#1E293B"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif"
                    android:text="Reminders, Screen Breaks &amp; Habits"
                    android:textColor="#64748B"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEngineStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="● Active"
                android:textColor="#059669"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Permission Banner (Shown ONLY when permission is missing) -->
        <LinearLayout
            android:id="@+id/llMandatoryOverlayBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_minimal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Display Over Other Apps Required"
                    android:textColor="#DC2626"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Needed to show your reminder companion"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMandatoryGrant"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_active"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Enable"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- HERO STATUS CARD: Interactive Companion Stage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero_glow"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Your Companion"
                        android:textColor="#1E293B"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Active • Eye break at 15m, Water at 30m"
                        android:textColor="#0284C7"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnableCompanion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Interactive Live Companion Preview Stage -->
            <FrameLayout
                android:id="@+id/flLiveCompanionStage"
                android:layout_width="match_parent"
                android:layout_height="195dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_minimal"
                android:clickable="true"
                android:focusable="true">

                <com.wellness.overlay3d.overlay.DevCompanionCanvasView
                    android:id="@+id/liveDashboardCompanion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <!-- Tap speech bubble -->
                <TextView
                    android:id="@+id/tvLiveCompanionSpeech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_speech_bubble"
                    android:elevation="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="👋 Tap me to interact!"
                    android:textColor="#0F172A"
                    android:textSize="12sp" />

            </FrameLayout>

            <!-- Interactive Poses Selector Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPoseHappy"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="🌟 Cheer"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPoseWater"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="💧 Drink"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPoseEyes"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="👀 Rest"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPoseTask"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="📋 Focus"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnPoseThread"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="🪢 Drop"
                    android:textColor="#334155"
                    android:textSize="11sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnTestCompanionNow"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="sans-serif-bold"
                android:text="✨ Test Overlay On Screen Now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- CARD 1: TIMERS & POSITIONING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_minimal"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Eye Strain Timing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="👀 Eye Break Threshold"
                android:textColor="#1E293B"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipEye15"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_active"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="15m"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipEye20"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="20m"
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipEye30"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="30m"
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipEye45"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="45m"
                    android:textColor="#475569"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="#EDE3E3" />

            <!-- Water Reminder Timing -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="💧 Water Intake Reminder"
                android:textColor="#1E293B"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipWater15"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="15m"
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipWater30"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_active"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="30m"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipWater45"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="45m"
                    android:textColor="#475569"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipWater60"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="60m"
                    android:textColor="#475569"
                    android:textSize="13sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="#EDE3E3" />

            <!-- Entrance Style -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="🎭 Default Entrance Style"
                android:textColor="#1E293B"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPosAuto"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_active"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="⚡ Auto"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPosThread"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="🪢 Drop"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPosTopRight"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="↗ Corner"
                    android:textColor="#475569"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPosBottom"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="🚶 Walk"
                    android:textColor="#475569"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- CARD 2: WORK & TASK REMINDERS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_minimal"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="📋 Work Reminders"
                    android:textColor="#1E293B"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAddNewTask"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_pill_active"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="+ Add"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/llTasksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="No reminders scheduled"
                android:textColor="#64748B"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
