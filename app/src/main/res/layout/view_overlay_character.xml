<?xml version="1.0" encoding="utf-8"?>
<!-- Reminder overlay. A vertical stack so the speech bubble can never cover the companion, even
     with large system fonts; OverlayWindowManager puts the companion first for the top entrances. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/speechBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_speech_bubble"
        android:elevation="6dp"
        android:focusable="true"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/speechText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp"
            android:maxLines="6"
            android:maxWidth="236dp"
            android:text="@string/water_message"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </LinearLayout>

    <com.wellness.overlay3d.overlay.HumanCompanionView
        android:id="@+id/humanCompanionView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="96dp" />

</LinearLayout>
