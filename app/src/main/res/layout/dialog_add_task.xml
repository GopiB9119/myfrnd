<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_minimal"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="Add Work Reminder"
        android:textColor="#1E293B"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="myfrnd will pop up and speak your task aloud."
        android:textColor="#64748B"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_unselected"
        android:fontFamily="sans-serif"
        android:hint="e.g. Finish report, drink vitamins..."
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#1E293B"
        android:textColorHint="#94A3B8"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="Choose When to Remind:"
        android:textColor="#334155"
        android:textSize="13sp" />

    <!-- Quick Pill Options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pillIn1Hour"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="In 1 Hr"
            android:textColor="#475569"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pillTodayEvening"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Today 8PM"
            android:textColor="#475569"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pillTomorrowMorning"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Tmrw 9AM"
            android:textColor="#475569"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnPickCustomDateTime"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_chip_selected"
        android:fontFamily="sans-serif-medium"
        android:text="📅 Choose Custom Date &amp; Time"
        android:textAllCaps="false"
        android:textColor="#0284C7"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvSelectedDateTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Selected: In 1 Hour"
        android:textColor="#059669"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelDialog"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:text="Cancel"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/btnSaveReminder"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_button_primary"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Save Reminder"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
