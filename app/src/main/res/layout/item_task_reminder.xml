<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/bg_pill_inactive"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/tvTaskTitle" style="@style/SectionTitle"
        android:tag="task" android:textSize="16sp" />
    <TextView android:id="@+id/tvTaskTime" style="@style/BodyText" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/btnEditTask" style="@style/Choice" android:text="@string/edit" />
        <Button android:id="@+id/btnDeleteTask" style="@style/Choice" android:text="@string/delete" />
    </LinearLayout>
</LinearLayout>
